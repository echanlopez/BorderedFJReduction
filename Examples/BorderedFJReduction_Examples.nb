Cell[BoxData[
 RowBox[{
  RowBox[{"CompositeSystem2", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"p1", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y1", "]"}]}], " ", "+", 
       " ", 
       RowBox[{"p2", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y2", "]"}]}], " ", "+", 
       "\n", "     ", 
       RowBox[{"p3", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y3", "]"}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p1", " ", "-", " ", "p2", " ", "+", " ", "p3"}], ")"}], " ", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y4", "]"}]}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           RowBox[{"p1", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"4", " ", 
           RowBox[{"p2", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"4", " ", "p2", "*", "p3"}], " ", "+", " ", 
          RowBox[{"3", " ", 
           RowBox[{"p3", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"p1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "p3"}], " ", "-", " ", 
             RowBox[{"4", " ", "p2"}]}], ")"}]}]}], ")"}]}], " ", "+", "\n", 
       "     ", 
       RowBox[{"m", "*", "g", " ", 
        RowBox[{"(", 
         RowBox[{
         "y1", " ", "+", " ", "y2", " ", "+", " ", "y3", " ", "+", " ", 
          "y4"}], ")"}]}], " ", "+", "\n", "     ", 
       RowBox[{
        RowBox[{"k", "/", "8"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "a"}], " ", "-", " ", "y1", " ", "-", " ", 
             "y2"}], ")"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "a"}], " ", "-", " ", "y2", " ", "-", " ", 
             "y3"}], ")"}], "^", "2"}], " ", "+", "\n", "          ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "a"}], " ", "-", " ", "y3", " ", "-", " ", 
             "y4"}], ")"}], "^", "2"}], " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "a"}], " ", "-", " ", "y4", " ", "-", " ", 
             "y1"}], ")"}], "^", "2"}]}], ")"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "y1", ",", " ", "y2", ",", " ", "y3", ",", " ", "y4", ",", " ", "p1", ",",
         " ", "p2", ",", " ", "p3"}], "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9969162336503544`*^9, 3.9969162336503544`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"bed914db-4bef-1345-ad27-81128384c507"],

