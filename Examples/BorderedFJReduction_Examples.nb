Cell[BoxData["\<\"Dependent constraint event at stage f^(1): every \
informative candidate of the 2-dimensional kernel lies in the ideal of the \
accumulated constraints (method GroebnerNormalForm). This is a gauge \
CANDIDATE; no generator is constructed or verified by this engine.\"\>"], \
"Output",
 CellChangeTimes->{3.9969177104192657`*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"6fd68f7b-0c7d-a245-b239-192faac88be4"]
}, Open  ]],

Cell["\<\
The candidates discarded as weakly zero are kept, so the discarded material \
is auditable rather than lost.\
\>", "Text",ExpressionUUID->"e6140102-7240-3048-a6cc-e2441073ffe0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bfj7", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{"\"\<Constraints\>\"", ",", " ", "\"\<RedundantConstraints\>\"", ",",
     " ", "\"\<Diagnostics\>\""}], "}"}]}]], "Input",
