  RowBox[{"\<\"Regularized\"\>", ",", "\<\"NotCandidateFound\"\>", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "x", " ", 
     RowBox[{"(", 
      RowBox[{"x", "+", 
       RowBox[{"2", " ", "z"}]}], ")"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.996917518029974*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"5ef63459-9126-0b4a-b7a7-582ecdaf85b3"]
}, Open  ]],

Cell["\<\
The reduction regularized the form, so the generalized brackets exist and are \
the inverse of the extended matrix.\
\>", "Text",ExpressionUUID->"ad52ee34-db32-a14c-ae5c-5aaae584af93"],

