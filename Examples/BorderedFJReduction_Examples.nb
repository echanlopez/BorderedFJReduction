 RowBox[{"{", 
  RowBox[{"\<\"CandidateFound\"\>", ",", "\<\"DependentConstraints\"\>", ",", 
   "2", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{3.9969177293504486`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"71b7e863-92ee-3146-8f8b-c567324651f2"]
}, Open  ]],

Cell[TextData[{
 "The engine halts with a two-dimensional residual kernel whose contractions \
both lie in the constraint ideal: the textbook signature of gauge freedom. \
Yet the Euler\[Dash]Lagrange equations of this Lagrangian are ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"q1", "'"}], "=", "q4"}], ",", 
   RowBox[{
    RowBox[{"q2", "'"}], "=", 
    RowBox[{"-", "q3"}]}]}]], "Input",ExpressionUUID->
  "fd8ed286-b644-9b42-adaf-76dd18638b10"],
 ", ",
 Cell[BoxData[
  RowBox[{"q1", "=", "0"}]], "Input",ExpressionUUID->
  "ff1905a1-9f8e-ac4e-9076-56445dff56e9"],
 " and ",
 Cell[BoxData[
  RowBox[{"q2", "=", "0"}]], "Input",ExpressionUUID->
  "8f5c845f-db5b-9d4d-8168-5ac87be8e4c4"],
 ", so ",
 Cell[BoxData[
 "q1"], "Input",ExpressionUUID->"032b200d-5891-0543-8239-eb5fa2e4d859"],
 " and ",
 Cell[BoxData[
 "q2"], "Input",ExpressionUUID->"4f17a394-0a6a-3a46-bd9d-e60d5fcdcfae"],
 " vanish identically and, differentiating, so do ",
 Cell[BoxData[
 "q3"], "Input",ExpressionUUID->"b83faac3-1cd4-3448-b132-045553978181"],
 " and ",
 Cell[BoxData[
 "q4"], "Input",ExpressionUUID->"13955107-a29c-4545-98f4-caf5699d6553"],
 ". The solution is unique: the system has zero degrees of freedom and admits \
no gauge transformation at all."
}], "Text",
 CellChangeTimes->{{3.9969163968558216`*^9, 
  3.9969164723847847`*^9}},ExpressionUUID->"7551c875-c283-8446-8894-\
5f125d71cfe2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"q1", " ", "and", " ", "q2", " ", "vanish", " ", "identically"}], 
    ",", " ", 
    RowBox[{
    "hence", " ", "so", " ", "do", " ", "dq1", " ", "and", " ", "dq2"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"q1", " ", "==", " ", "0"}], ",", " ", 
      RowBox[{"q2", " ", "==", " ", "0"}], ",", " ", 
      RowBox[{"dq1", " ", "==", " ", "q4"}], ",", " ", 
      RowBox[{"dq2", " ", "==", " ", 
       RowBox[{"-", "q3"}]}], ",", " ", 
      RowBox[{"dq1", " ", "==", " ", "0"}], ",", " ", 
      RowBox[{"dq2", " ", "==", " ", "0"}]}], "}"}], ",", "\n", "      ", 
    RowBox[{"{", 
     RowBox[{
     "q1", ",", " ", "q2", ",", " ", "q3", ",", " ", "q4", ",", " ", "dq1", ",",
       " ", "dq2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9969164786961327`*^9, 3.9969164786961327`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"cd958927-5edb-244e-b493-643f2550ef71"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"q1", "\[Rule]", "0"}], ",", 
    RowBox[{"q2", "\[Rule]", "0"}], ",", 
    RowBox[{"q3", "\[Rule]", "0"}], ",", 
    RowBox[{"q4", "\[Rule]", "0"}], ",", 
    RowBox[{"dq1", "\[Rule]", "0"}], ",", 
    RowBox[{"dq2", "\[Rule]", "0"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9969177343514423`*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"150b7fc2-d166-e94d-a2be-feb93b97e9c4"]
}, Open  ]],

Cell[TextData[{
 "The mechanism is visible in the potential itself, which depends on the \
degenerate coordinates only through the constraints: ",
 Cell[BoxData[
  RowBox[{"V", "=", 
   RowBox[{
    RowBox[{"q3", " ", "\[CapitalOmega]1"}], "+", 
    RowBox[{"q4", " ", "\[CapitalOmega]2"}]}]}]], "Input",ExpressionUUID->
  "4dca7785-8678-ad42-99f5-905b0955bc70"],
 " with ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]1", "=", "q1"}]], "Input",ExpressionUUID->
  "fe61070d-a394-864e-ae16-e4c296443397"],
 " and ",
 Cell[BoxData[
  RowBox[{"\[CapitalOmega]2", "=", "q2"}]], "Input",ExpressionUUID->
  "b470b3f6-eb08-374f-8c08-ea1bd774250b"],
 ". Every contraction is then automatically in the ideal, and no \
ideal-membership test \[LongDash] however exact \[LongDash] can tell this \
situation apart from genuine gauge freedom. What separates a generator from a \
mere null direction is a criterion that lives outside the reduction, which is \
precisely why this engine stops at the candidate."
}], "Text",
 CellChangeTimes->{{3.9969165046897583`*^9, 
  3.9969165776263294`*^9}},ExpressionUUID->"27200513-a070-804b-a708-\
113cf374e537"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["7. Diagnostics, tracing and failure modes",
 FontColor->RGBColor[0.6, 0, 0]]], "Section",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 10}, {5, 5}},
 CellFrameColor->RGBColor[0.6, 0, 0],
 CellChangeTimes->{{3.9841600295676575`*^9, 3.9841600299620647`*^9}, {
   3.984160109139717*^9, 3.9841601650218716`*^9}, {3.9841602725877094`*^9, 
   3.9841603231017017`*^9}, {3.984160401527149*^9, 3.9841604279416504`*^9}, {
   3.984160499972679*^9, 3.984160500582493*^9}, {3.9961034389690857`*^9, 
