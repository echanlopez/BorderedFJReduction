 TemplateBox[{
  "BorderedFJMatrix", "maxit", 
   "\"The value \\!\\(\\*RowBox[{\\\"0\\\"}]\\) of \\\"MaxIterations\\\" is \
not a positive integer or Infinity.\"", 2, 58, 3, 20589965176296970594, 
   "Local", "BorderedFJReduction`BorderedFJMatrix"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
