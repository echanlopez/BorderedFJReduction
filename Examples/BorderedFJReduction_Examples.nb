Cell[TextData[{
 "FJSymplecticFrame labels the generalized brackets by the extended \
phase-space variables, Lagrange multipliers included. It applies only to a \
regularized reduction: on a candidate or inconsistent object it issues ",
 Cell[BoxData[
  RowBox[{"FJSymplecticFrame", "::", "noinv"}]], "Input",ExpressionUUID->
  "d3e2ff45-3755-8747-8eb8-de10d99933fc"],
 " and returns ",
 Cell[BoxData[
 "$Failed"], "Input",ExpressionUUID->"db8afce9-31de-bf45-a3ea-88d00c3c590e"],
 "."
}], "Text",
 CellChangeTimes->{{3.9969160334951515`*^9, 
  3.9969160550590515`*^9}},ExpressionUUID->"4fe6c2f1-ccb0-6547-826a-\
4f74dd4c454f"],

