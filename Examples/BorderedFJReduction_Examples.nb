Cell[BoxData[
 RowBox[{
  RowBox[{"CompositeSystem1", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"p1", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y1", "]"}]}], " ", "+", 
       " ", 
       RowBox[{"p2", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y2", "]"}]}], " ", "+", 
       "\n", "     ", 
       RowBox[{"p3", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y3", "]"}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p1", " ", "-", " ", "p2", " ", "+", " ", "p3"}], ")"}], " ", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y4", "]"}]}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", "\n", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           RowBox[{"p1", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"4", " ", 
           RowBox[{"p2", "^", "2"}]}], " ", "-", " ", 
          RowBox[{"4", " ", "p2", "*", "p3"}], " ", "+", " ", 
          RowBox[{"3", " ", 
           RowBox[{"p3", "^", "2"}]}], " ", "+", " ", 
          RowBox[{"p1", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "p3"}], " ", "-", " ", 
             RowBox[{"4", " ", "p2"}]}], ")"}]}]}], ")"}]}], " ", "+", "\n", 
       "     ", 
       RowBox[{"m", "*", "g", " ", 
        RowBox[{"(", 
         RowBox[{
         "y1", " ", "+", " ", "y2", " ", "+", " ", "y3", " ", "+", " ", 
          "y4"}], ")"}]}], " ", "+", "\n", "     ", 
       RowBox[{
        RowBox[{"k", "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", " ", "-", " ", "y1"}], ")"}], "^", "2"}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", " ", "-", " ", "y2"}], ")"}], "^", "2"}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", " ", "-", " ", "y3"}], ")"}], "^", "2"}], " ", "+", 
          " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", " ", "-", " ", "y4"}], ")"}], "^", "2"}]}], 
         ")"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "y1", ",", " ", "y2", ",", " ", "y3", ",", " ", "y4", ",", " ", "p1", ",",
         " ", "p2", ",", " ", "p3"}], "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996916008178135*^9, 3.9969160081800976`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"3ad8a7d7-7e32-0f44-b9c9-08aec29c91da"],

