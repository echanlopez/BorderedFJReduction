Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{"-", 
       FractionBox["1", "x"]}], "0", "0"},
     {
      FractionBox["1", "x"], "0", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"x", "+", "z"}], 
        SuperscriptBox["x", "2"]]}], 
      RowBox[{"-", 
       FractionBox["1", 
        SuperscriptBox["x", "2"]]}]},
     {"0", 
      FractionBox[
       RowBox[{"x", "+", "z"}], 
       SuperscriptBox["x", "2"]], "0", 
      RowBox[{"-", 
       FractionBox["1", "x"]}]},
     {"0", 
      FractionBox["1", 
       SuperscriptBox["x", "2"]], 
      FractionBox["1", "x"], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9969175266784077`*^9},
 CellLabel->
  "Out[10]//MatrixForm=",ExpressionUUID->"5ee30311-953d-bd44-913b-\
58662bda7a00"]
}, Open  ]],

Cell["\<\
Two invariants hold for every object returned by the engine and are worth \
using as an audit of the recursion: the number of bordering rounds equals the \
length of the per-stage record, and the total of that record equals the \
number of Lagrange multipliers introduced.\
\>", "Text",ExpressionUUID->"a0417845-4e32-784a-89e5-33ecb8f956d7"],

Cell[CellGroupData[{

Cell["\<\
Length[bfj1[\"ConstraintsPerStage\"]] === bfj1[\"IterationCount\"]
Total[bfj1[\"ConstraintsPerStage\"]] === bfj1[\"MultiplierCount\"]\
\>", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"1031fce8-5116-1d47-a74e-c5ca3fe3191d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9969175307493076`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"26dd0c65-8caf-be44-bc48-cd855fc3723d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9969175307513103`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"56255194-1004-6749-8d67-b73346ac60cd"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<PassCount\>\""], "Input",ExpressionUUID->
  "cda113e2-69e8-5146-aba3-4a22082e91c1"],
 " exceeds ",
 Cell[BoxData["\"\<IterationCount\>\""], "Input",ExpressionUUID->
  "9d116908-76b0-684f-9834-f0b7073ab406"],
 " by exactly the terminal readout pass, in which the engine recomputes the \
kernel of the final matrix, finds it empty, and halts."
}], "Text",
