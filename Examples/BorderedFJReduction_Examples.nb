Cell["ToSubscript is Listable, so it threads over matrices.", "Text",ExpressionUUID->"1e9725a0-b6b6-c349-98a2-5d22fbaca3a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b1", ",", " ", "b2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b3", ",", " ", "b4"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MatrixForm", " ", "@", " ", 
    RowBox[{"ToSubscript", "[", "#", "]"}]}], " ", "&"}], " ", "@", " ", 
  "B"}]}], "Input",
 CellChangeTimes->{{3.996916068195318*^9, 3.996916068195318*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"bdbe0901-3e52-0544-834b-13328a5f8868"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      SubscriptBox["b", "1"], 
      SubscriptBox["b", "2"]},
     {
      SubscriptBox["b", "3"], 
      SubscriptBox["b", "4"]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9969176311701145`*^9},
 CellLabel->
  "Out[36]//MatrixForm=",ExpressionUUID->"a81f16ac-6ef2-f54d-9d0a-\
bdbaac884eb6"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["6. Gauge candidates",
 FontColor->RGBColor[0.6, 0, 0]]], "Section",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 10}, {5, 5}},
 CellFrameColor->RGBColor[0.6, 0, 0],
 CellChangeTimes->{{3.9841600295676575`*^9, 3.9841600299620647`*^9}, {
   3.984160109139717*^9, 3.9841601650218716`*^9}, {3.9841602725877094`*^9, 
   3.9841603231017017`*^9}, {3.984160401527149*^9, 3.9841604279416504`*^9}, {
   3.984160499972679*^9, 3.984160500582493*^9}, {3.9961034389690857`*^9, 
   3.996103440260908*^9}, {3.9961034702925396`*^9, 3.9961034747700024`*^9}, {
   3.9968395131290913`*^9, 3.996839514274994*^9}, {3.9968788401676693`*^9, 
   3.996878894055361*^9}, 3.996878943893791*^9, {3.9968789957088375`*^9, 
   3.9968789965162144`*^9}, {3.996914207270321*^9, 3.996914207400297*^9}},
 Background->RGBColor[
  0.9803921568627451, 0.984313725490196, 0.9490196078431372],
 CellTags->"section6",ExpressionUUID->"487bc229-119e-2c45-872b-8c329a6af9c0"],

Cell[TextData[{
 "When the recursion stalls with a residual kernel whose consistency \
contractions vanish weakly, the engine reports\n\n    ",
 Cell[BoxData[
  RowBox[{"\"\<GaugeSymmetry\>\"", "->", "\"\<CandidateFound\>\""}]], "Input",
  ExpressionUUID->"cb0953ab-ac16-fc46-a440-1ae57c362794"],
 "\n    ",
 Cell[BoxData[
  RowBox[{"\"\<MatrixStatus\>\"", "->", "\"\<GaugeCandidate\>\""}]], "Input",
  ExpressionUUID->"ca5ea4c1-21a5-8a44-9103-1e3a911888c6"],
 "\n\nand stops. The word ",
 StyleBox["candidate",
  FontWeight->"Bold"],
 " is not editorial caution: the halt is a necessary signature of first-class \
content, never a sufficient one. The last subsection exhibits a system that \
produces this halt and has no gauge freedom whatsoever."
}], "Text",
 CellChangeTimes->{{3.9969161015393734`*^9, 
  3.9969161342075825`*^9}},ExpressionUUID->"83c41b46-3a66-2945-a845-\
937e0c853795"],

Cell[CellGroupData[{

Cell["6.1 Branch 1: null contractions", "Subsection",
 CellChangeTimes->{{3.996914214714958*^9, 3.996914216784073*^9}},
 CellTags->
  "subsection61",ExpressionUUID->"c995c78b-585e-ac48-95e1-fdfa6826ea7e"],

Cell["\<\
A ring-coupled variant of the previous composite system. Here every \
contraction of the residual kernel with the gradient of the potential \
vanishes identically, so no further constraint can be generated.\
\>", "Text",ExpressionUUID->"a59cd7b5-fa6f-e247-ad44-fb3fa4214260"],

