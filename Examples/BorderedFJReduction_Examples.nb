Cell[TextData[{
 "A singular Lagrangian with noncanonical kinetics. The one-form is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{"z", ",", " ", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "2"}], ",", " ", "0"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b536c130-962a-1f4f-b380-0184a7d45a1c"],
 ", so the pre-symplectic matrix is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "d692734e-7813-6f45-a099-f3c7370b7aa8"],
 " antisymmetric and therefore singular: its kernel is one-dimensional and \
generates a single constraint."
}], "Text",
 CellChangeTimes->{{3.996914512965912*^9, 3.996914527272955*^9}, {
  3.9969196180523205`*^9, 
  3.9969196489495487`*^9}},ExpressionUUID->"8e4d9143-6812-d347-8ac1-\
85ab55e41154"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ex1", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"z", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "x", "]"}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "/", "2"}], "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y", "]"}]}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "^", "2"}], "/", "2"}], " ", "+", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "/", "2"}], " ", "y"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}]}], "|>"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996914571794428*^9, 3.9969145717954273`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"1acfa88e-8266-3b41-aca7-5693957c759c"],

Cell[TextData[{
 "Since v0.1.3 the association may be passed directly. The idiom used in \
earlier versions of this notebook, ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"BorderedFJMatrix", "@@", 
    RowBox[{"Lookup", "[", 
     RowBox[{"#", ",", 
      RowBox[{"Keys", "@", "#"}]}], "]"}]}], "&"}]], "Input",ExpressionUUID->
  "097d5fe6-ba16-d94e-93f8-67d0f682ce3e"],
 ", still works and is equivalent."
}], "Text",
 CellChangeTimes->{{3.9969145866624165`*^9, 
  3.9969145970475826`*^9}},ExpressionUUID->"3be0d5bc-c0ff-7e41-aa36-\
df2f8d2cc88b"],

