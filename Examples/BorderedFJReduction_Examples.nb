        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "x1", "]"}], " ", "+", 
         " ", 
         RowBox[{
          RowBox[{"Derivative", "[", "1", "]"}], "[", "x2", "]"}]}], 
        ")"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"p1", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "m"}], ")"}]}], " ", "-", " ", 
       RowBox[{"m", "*", "g", "*", 
        RowBox[{"(", 
         RowBox[{"x1", " ", "+", " ", "x2"}], ")"}]}], " ", "+", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"k1", "/", "2"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x1", " ", "-", " ", "l1"}], ")"}], "^", "2"}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"k2", "/", "2"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x2", " ", "-", " ", "l2"}], ")"}], "^", "2"}]}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"x1", ",", " ", "x2", ",", " ", "p1"}], "}"}]}]}], "|>"}]}], 
  ";"}]], "Input",
