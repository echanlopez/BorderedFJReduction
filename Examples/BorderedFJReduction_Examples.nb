In[58]:=",ExpressionUUID->"ec156366-b4da-414c-91f3-28bb30478ead"],

Cell[BoxData["$Failed"], "Output",
 CellChangeTimes->{3.9969178129608936`*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"d6380c01-c8f8-8e4f-a3b8-56d4fb9cca8a"]
}, Open  ]],

Cell[TextData[{
 "Exhausting the allowed bordering rounds is a different failure, reported by \
",
 Cell[BoxData[
  RowBox[{"BorderedFJMatrix", "::", "iter"}]], "Input",ExpressionUUID->
  "a42a8779-cb9c-5847-a913-fe9319dad858"],
 ", which also returns ",
 Cell[BoxData[
 "$Failed"], "Input",ExpressionUUID->"912711c6-fd12-e348-8038-37652fac5952"],
 ": an unregularized object is never handed back as if it were a result. Note \
that the terminal readout pass is always granted, so a system that needs \
exactly one round succeeds under ",
 Cell[BoxData[
  RowBox[{"\"\<MaxIterations\>\"", "->", "1"}]], "Input",ExpressionUUID->
  "d25c76f3-f987-6140-84ec-27e50b37cdb1"],
 "."
}], "Text",
 CellChangeTimes->{{3.9969167263905544`*^9, 
  3.9969167773228283`*^9}},ExpressionUUID->"d2786bf8-69c1-814b-bd94-\
bc6b47a241b7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["8. Migration from v0.1.2",
 FontColor->RGBColor[0.6, 0, 0]]], "Section",
 CellFrame->{{2, 0}, {0, 0}},
 CellFrameMargins->{{10, 10}, {5, 5}},
 CellFrameColor->RGBColor[0.6, 0, 0],
 CellChangeTimes->{{3.9841600295676575`*^9, 3.9841600299620647`*^9}, {
   3.984160109139717*^9, 3.9841601650218716`*^9}, {3.9841602725877094`*^9, 
   3.9841603231017017`*^9}, {3.984160401527149*^9, 3.9841604279416504`*^9}, {
   3.984160499972679*^9, 3.984160500582493*^9}, {3.9961034389690857`*^9, 
   3.996103440260908*^9}, {3.9961034702925396`*^9, 3.9961034747700024`*^9}, {
   3.9968395131290913`*^9, 3.996839514274994*^9}, {3.9968788401676693`*^9, 
   3.996878894055361*^9}, 3.996878943893791*^9, {3.9968789957088375`*^9, 
   3.9968790181201763`*^9}, 3.9968790485484505`*^9, {3.996923643243393*^9, 
   3.9969236436348248`*^9}},
 Background->RGBColor[
  0.9803921568627451, 0.984313725490196, 0.9490196078431372],
 CellTags->"section8",ExpressionUUID->"f228e2f2-6ee3-8e44-8af3-c1e1a4086499"],

Cell[TextData[{
 StyleBox["Verdict vocabulary.",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData["\"\<GaugeSymmetry\>\""], "Input",ExpressionUUID->
  "e43ebc48-0832-1949-8524-414b646e414a"],
 ": ",
 Cell[BoxData["\"\<Found\>\""], "Input",ExpressionUUID->
  "0d360869-5f9d-5d4c-9b97-b3656a4712df"],
 "/",
 Cell[BoxData["\"\<NotFound\>\""], "Input",ExpressionUUID->
  "d5ab68fc-e893-3748-a95a-bcecb9e3738b"],
 Cell[BoxData["->"], "Input",ExpressionUUID->
  "277ad10d-4791-564d-be4d-64460ed6133b"],
 Cell[BoxData["\"\<CandidateFound\>\""], "Input",ExpressionUUID->
  "2bf70257-5136-1c41-a523-e0ee1f90f6b3"],
 "/",
 Cell[BoxData["\"\<NotCandidateFound\>\""], "Input",ExpressionUUID->
  "2ba99a63-694f-5241-ab55-7369b32a849c"],
 "\n",
 Cell[BoxData["\"\<MatrixStatus\>\""], "Input",ExpressionUUID->
  "031fac01-9076-d642-88f2-a1389b3661a2"],
 ":  ",
 Cell[BoxData["\"\<GaugeDetected\>\""], "Input",ExpressionUUID->
  "1eb30cae-90ec-4e4c-a8cf-98f632963d0f"],
 Cell[BoxData["->"], "Input",ExpressionUUID->
  "6a2eb432-8550-f54a-aa73-7f6f4d259b1f"],
 Cell[BoxData["\"\<GaugeCandidate\>\""], "Input",ExpressionUUID->
  "d5b3ebfc-40be-d643-8cf1-bd0c8818abaa"],
 "\n",
 Cell[BoxData["\"\<GaugeDetectionReason\>\""], "Input",ExpressionUUID->
  "3a020917-f9d7-6742-8abe-04c8ae19c2d8"],
 Cell[BoxData["->"], "Input",ExpressionUUID->
  "edd7c4ac-afff-144e-8406-76cfcee84905"],
 Cell[BoxData["\"\<GaugeCandidateReason\>\""], "Input",ExpressionUUID->
  "6fc70068-fe9c-4d43-922b-b176e79c6e3a"],
 " (old key kept as a deprecated alias)\n",
 Cell[BoxData["\"\<PartialExtendedMatrix\>\""], "Input",ExpressionUUID->
  "df0e50b3-b736-5747-905d-0f31dea5ea72"],
 Cell[BoxData["->"], "Input",ExpressionUUID->
  "b1c16186-3bcb-2747-ac4e-1c9c38420a55"],
 Cell[BoxData["\"\<ExtendedMatrix\>\""], "Input",ExpressionUUID->
  "39847431-a738-1b45-9355-fa9c94abe945"],
 " (old key kept as a deprecated alias)\n\n",
 StyleBox["Counters.",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData["\"\<IterationCount\>\""], "Input",ExpressionUUID->
  "3f6ed42a-a635-d747-951a-58ed595f7f83"],
 " now counts bordering rounds, not constraints; code that compared it with \
the number of constraints must use ",
 Cell[BoxData["\"\<ConstraintsLength\>\""], "Input",ExpressionUUID->
  "3e01336f-26ef-0346-ad5f-9187ee69a4a7"],
 " or ",
 Cell[BoxData["\"\<MultiplierCount\>\""], "Input",ExpressionUUID->
  "55260afe-0599-7148-b100-e9d299a8bc38"],
 ".\n ",
 Cell[BoxData["\"\<PassCount\>\""], "Input",ExpressionUUID->
  "171b4874-590c-204c-b729-aec8f0ea8207"],
 " is new and counts algorithm passes, including the terminal readout.\n\n",
 StyleBox["New keys.\n",
  FontWeight->"Bold"],
 Cell[BoxData["\"\<GaugeCandidateBranch\>\""], "Input",ExpressionUUID->
  "e84a600a-8304-7a41-8dc4-e347ae10f583"],
 ", ",
 Cell[BoxData["\"\<GaugeCandidateMethod\>\""], "Input",ExpressionUUID->
  "53bfa30d-3915-d843-aaac-0be7df929eaa"],
 ", ",
 Cell[BoxData["\"\<KernelDimension\>\""], "Input",ExpressionUUID->
  "d9aec5a5-2317-2a4d-b096-614229ec332f"],
 ", ",
 Cell[BoxData["\"\<CandidateMultiplicity\>\""], "Input",ExpressionUUID->
  "60f85bc8-7fbb-9a45-ac44-820b2b0d9eb1"],
 ", ",
 Cell[BoxData["\"\<GaugeAnalysis\>\""], "Input",ExpressionUUID->
  "990b721a-70f3-fe49-9812-2037a4046b45"],
 ", ",
 Cell[BoxData["\"\<ConstraintsPerStage\>\""], "Input",ExpressionUUID->
  "af522059-72d0-d746-8b11-c2403aecceb6"],
 ", ",
 Cell[BoxData["\"\<MultiplierCount\>\""], "Input",ExpressionUUID->
  "70d93bc3-5f8e-9445-90b9-2786d25abcc8"],
 ", ",
 Cell[BoxData["\"\<RedundantConstraints\>\""], "Input",ExpressionUUID->
  "9df4f4d7-fcc0-124c-b5ed-07c17ef2eabf"],
 ", ",
 Cell[BoxData["\"\<Diagnostics\>\""], "Input",ExpressionUUID->
  "f2c1e451-ad9b-4c4e-863b-86b83a4a05eb"],
 ", ",
 Cell[BoxData["\"\<StageData\>\""], "Input",ExpressionUUID->
  "62e4bbae-cdbb-174a-a7af-02d1ab2a2b08"],
 ", ",
 Cell[BoxData["\"\<InconsistencyWitness\>\""], "Input",ExpressionUUID->
  "cfe4e4ac-f863-f145-b953-5e5b03e41d16"],
 ".\n\n",
 StyleBox["Behaviour that changed silently.",
  FontWeight->"Bold"],
 "\nIdentically zero candidates are no longer adjoined as constraints; \
multipliers are numbered globally across rounds; redundancy is decided by \
ideal membership rather than by linear independence of gradients. Reductions \
whose v0.1.2 output contained spurious multipliers or duplicated constraints \
will therefore return smaller, correct systems."
}], "Text",
 CellChangeTimes->{{3.996916820251417*^9, 3.9969171176492615`*^9}, {
  3.996917154376734*^9, 
  3.9969174076311607`*^9}},ExpressionUUID->"36454720-3b9a-9a49-af4f-\
caa6e623c082"]
}, Open  ]],

