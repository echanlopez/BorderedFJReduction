Cell[TextData[{
 "The pre-symplectic matrix of a given one-form can be computed on its own, \
without running the reduction. Here a is the one-form of a charged particle \
in a magnetic field with a noncommutativity parameter ",
 Cell[BoxData[
 "\[Theta]"], "Input",ExpressionUUID->"8d0fc94b-90f2-3546-b2cf-04a3b2d0be80"],
 "."
}], "Text",
 CellChangeTimes->{{3.996915807686165*^9, 
  3.996915813673565*^9}},ExpressionUUID->"76acd41a-e536-6b4d-8e9e-\
ed575580598a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aa", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "p1"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"B0", "/", "2"}], " ", "x2"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "p2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"B0", "/", "2"}], " ", "x1"}]}], ",", "\n", "      ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], " ", "x1"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"\[Theta]", "/", "2"}], " ", "p2"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], " ", "x2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"\[Theta]", "/", "2"}], " ", "p1"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Xi]", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2", ",", " ", "p1", ",", " ", "p2"}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9969158829978504`*^9, 3.9969158829978504`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"87446268-32c6-af48-bf3d-dffa899e2fb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FaddeevJackiwMatrix", "[", 
   RowBox[{"aa", ",", " ", "\[Xi]"}], "]"}], " ", "//", " ", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.9969158830003853`*^9, 3.9969158830003853`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"61524c12-f3c2-e542-8007-edccd6816b97"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", "B0", 
      RowBox[{"-", "1"}], "0"},
     {
      RowBox[{"-", "B0"}], "0", "0", 
      RowBox[{"-", "1"}]},
     {"1", "0", "0", "\[Theta]"},
     {"0", "1", 
      RowBox[{"-", "\[Theta]"}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.99691759757201*^9},
 CellLabel->
  "Out[29]//MatrixForm=",ExpressionUUID->"56ce4c7b-de11-864e-9c92-\
5fda2717729a"]
}, Open  ]]
}, Open  ]],

