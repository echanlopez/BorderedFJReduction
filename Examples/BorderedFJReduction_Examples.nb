Cell[TextData[{
 "Two masses coupled by springs and constrained to move together: the single \
momentum ",
 Cell[BoxData[
 "p1"], "Input",ExpressionUUID->"593bda61-1600-0647-99d7-7e25b75e212a"],
 " conjugate to both coordinates makes the kinetic term degenerate."
}], "Text",
