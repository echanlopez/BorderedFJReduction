Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<TraceStages\>\"", "->", "True"}]], "Input",ExpressionUUID->
  "dadf54c3-3394-ce48-9b9b-0104f378e9f6"],
 " the engine records, for every pass, the kernel of the current matrix, its \
contractions with the gradient of the potential, and the split of the null \
vectors into transient (constraint-generating) and persistent (candidate) \
modes."
}], "Text",
 CellChangeTimes->{{3.996916623201313*^9, 
  3.996916630569912*^9}},ExpressionUUID->"6d974dda-94f0-e941-8cef-\
933bd35098d0"],

