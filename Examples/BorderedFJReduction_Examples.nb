Cell[BoxData[
 RowBox[{
  RowBox[{"TwoSpringsPendulum", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"px", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "x", "]"}]}], " ", "+", 
       " ", 
       RowBox[{"py", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y", "]"}]}], " ", "+", 
       "\n", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"px", "*", "l", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], " ", "+", " ", 
          RowBox[{"py", "*", "l", "*", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ")"}], "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Theta]", "]"}]}]}]}], 
     ",", "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m"}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"px", "^", "2"}], " ", "+", " ", 
          RowBox[{"py", "^", "2"}]}], ")"}]}], " ", "+", " ", 
       RowBox[{"k", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], " ", "+", " ", 
          RowBox[{"y", "^", "2"}], " ", "+", " ", 
          RowBox[{"d", "^", "2"}]}], ")"}]}], " ", "+", "\n", "     ", 
       RowBox[{"m", "*", "g", "*", 
        RowBox[{"(", 
         RowBox[{"y", " ", "-", " ", 
          RowBox[{"l", "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "x", ",", " ", "y", ",", " ", "\[Theta]", ",", " ", "px", ",", " ", 
        "py"}], "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996915457630396*^9, 3.996915457630396*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"c05cdc84-b2de-3843-9220-c31af0f7f20d"],

