Cell[CellGroupData[{

Cell["7.3 Validated input", "Subsection",
 CellChangeTimes->{{3.9969142508569717`*^9, 3.9969142521930943`*^9}},
 CellTags->
  "subsection73",ExpressionUUID->"fcba13cb-5996-b745-88c7-b228d46f511d"],

Cell[TextData[{
 "The kinetic term must be linear in the atomic velocities: a genuinely \
second-order Lagrangian is rejected with ",
 Cell[BoxData[
  RowBox[{"BorderedFJMatrix", "::", "lin"}]], "Input",ExpressionUUID->
  "4603e72c-b4e6-1d47-bc1d-96fd9b736617"],
 " instead of silently producing a velocity-dependent one-form and a \
meaningless ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["f", "TI"], 
        RowBox[{"(", "0", ")"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "$f^(0)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2590757f-da9f-8647-ae39-1949b65ef7ec"],
 "."
}], "Text",
 CellChangeTimes->{{3.9969166832380047`*^9, 
  3.9969167191510334`*^9}},ExpressionUUID->"2fd71db5-188d-9d44-bf39-\
a25b84f14f78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BorderedFJMatrix", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", "1", "]"}], "[", "x", "]"}], "^", "2"}], "/",
       "2"}]}], ",", "\n", "                   ", 
    RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "/", "2"}]}], ",", "\n", "                   ", 
    RowBox[{"\"\<vars\>\"", " ", "->", " ", 
     RowBox[{"{", "x", "}"}]}]}], "|>"}], "]"}]], "Input",
 CellChangeTimes->{{3.996916695439268*^9, 3.996916695439268*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"4744cc5f-8a40-1d4e-b7b6-de5e820a77a1"],

Cell[BoxData[
 TemplateBox[{
  "BorderedFJMatrix", "lin", 
   "\"The kinetic energy is not linear in the velocities Derivative[1][q]; \
the Lagrangian is not first-order.\"", 2, 57, 2, 20589965176296970594, 
   "Local", "BorderedFJReduction`BorderedFJMatrix"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9969178017394943`*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[57]:=",ExpressionUUID->"fcb6a219-f14c-8545-be9b-0fc0fb5b3e83"],

Cell[BoxData["$Failed"], "Output",
 CellChangeTimes->{3.9969178017469063`*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"15ce5d04-4ca1-f14d-b069-dea388cccb89"]
}, Open  ]],

Cell["\<\
The option itself is validated: it must be a positive integer or Infinity.\
\>", "Text",ExpressionUUID->"c27fb8d6-0030-ae49-b830-892abf199e15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BorderedFJMatrix", "[", 
  RowBox[{"MassesSpringsRing", ",", " ", 
   RowBox[{"\"\<MaxIterations\>\"", " ", "->", " ", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996916699985056*^9, 3.996916699985056*^9}},
