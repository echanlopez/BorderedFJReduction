Cell[BoxData[
 RowBox[{
  RowBox[{"MassesSpringsRing", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"p\[Theta]1", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Theta]1", "]"}]}], 
       " ", "+", " ", 
       RowBox[{"p\[Theta]2", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Theta]2", "]"}]}], 
       " ", "+", " ", 
       RowBox[{"p\[Theta]3", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "\[Theta]3", "]"}]}]}]}],
      ",", "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "m", " ", 
           RowBox[{"R", "^", "2"}]}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"p\[Theta]1", "^", "2"}], " ", "+", " ", 
          RowBox[{"p\[Theta]2", "^", "2"}], " ", "+", " ", 
          RowBox[{"p\[Theta]3", "^", "2"}]}], ")"}]}], " ", "+", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"k", "/", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Cos", "[", "\[Theta]1", "]"}]}]}], ")"}], "^", "2"}], 
          " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Sin", "[", "\[Theta]1", "]"}]}]}], ")"}], "^", "2"}], 
          " ", "+", "\n", "          ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Cos", "[", "\[Theta]2", "]"}]}]}], ")"}], "^", "2"}], 
          " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Sin", "[", "\[Theta]2", "]"}]}]}], ")"}], "^", "2"}], 
          " ", "+", "\n", "          ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Cos", "[", "\[Theta]3", "]"}]}]}], ")"}], "^", "2"}], 
          " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", " ", "-", " ", 
             RowBox[{"R", "*", 
              RowBox[{"Sin", "[", "\[Theta]3", "]"}]}]}], ")"}], "^", "2"}]}],
          ")"}]}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\[Theta]1", ",", " ", "\[Theta]2", ",", " ", "\[Theta]3", ",", " ", 
        "x", ",", " ", "y", ",", " ", "p\[Theta]1", ",", " ", "p\[Theta]2", ",",
         " ", "p\[Theta]3"}], "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996915520375004*^9, 3.9969155203760166`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"350411c8-44cd-d84c-8e46-d1bf3c821846"],

