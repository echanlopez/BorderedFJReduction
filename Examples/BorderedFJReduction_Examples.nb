Cell[TextData[{
 "BorderedFJMatrix takes a first-order Lagrangian ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], ".", 
         SuperscriptBox["\[Xi]", "\[Prime]"], "-", 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$L = a.\\xi' - V$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "272cf904-d9b6-7546-924b-1da4ac8f143a"],
 " and returns an opaque symbolic object. The information panel lists the \
signature, the options and the verdict vocabulary."
}], "Text",
 CellChangeTimes->{{3.996914431966364*^9, 
  3.9969144564722557`*^9}},ExpressionUUID->"13d4848e-5a26-0f4e-b3fc-\
6b72a718a89a"],

