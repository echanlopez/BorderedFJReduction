Cell[TextData[{
 "The candidate keys replace the single prose string of v0.1.2. The key ",
 Cell[BoxData["\"\<GaugeDetectionReason\>\""], "Input",ExpressionUUID->
  "740607bc-4b3e-ea47-931b-9ae6c51db2d9"],
 " still resolves, as a deprecated alias of ",
 Cell[BoxData["\"\<GaugeCandidateReason\>\""], "Input",ExpressionUUID->
  "3ba3bc9a-ce9d-0e44-a739-2dac05485b61"],
 "."
}], "Text",
