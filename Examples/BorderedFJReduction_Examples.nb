 CellLabel->"In[47]:=",ExpressionUUID->"2c3524c7-8cb8-f846-bf80-506e6f1bf4d0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"q1", "+", "q2", "+", "q4"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"-", "p3"}], "-", "q1", "-", "q2", "-", "q4"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "p3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Null constraint event (x1): consistency identically \
satisfied along part of the kernel.\"\>", 
     ",", "\<\"Redundant constraint event (x1, method GroebnerNormalForm): \
candidate lies in the ideal of the accumulated constraints.\"\>"}], "}"}]}], 
  "}"}]], "Output",
