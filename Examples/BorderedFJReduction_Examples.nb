Cell[CellGroupData[{

Cell["7.2 Inconsistent systems", "Subsection",
 CellChangeTimes->{{3.9969142439316025`*^9, 3.996914247482786*^9}},
 CellTags->
  "subsection72",ExpressionUUID->"2d372816-612e-024b-95cd-780e87bbe475"],

Cell[TextData[{
 "If a consistency condition produces a nonvanishing constraint that is free \
of the phase-space variables, the system admits no solution at all. Below, \
the variable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$z$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46a26d06-2bcf-164d-8989-7b97a158a27a"],
 " carries no momentum and the potential is linear in it, so the consistency \
condition demands ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$g = 0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f76f41b4-dc79-054a-a3ad-bee1543bed35"],
 ". Up to v0.1.2 this situation had no branch of its own and could be \
absorbed into a false gauge verdict."
}], "Text",
 CellChangeTimes->{{3.996916656714733*^9, 
  3.996916669526972*^9}},ExpressionUUID->"83cc7d39-6321-a541-824f-\
3f207ffeda88"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"inconsistentSystem", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{"p", " ", 
       RowBox[{
        RowBox[{"Derivative", "[", "1", "]"}], "[", "q", "]"}]}]}], ",", "\n",
      "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "^", "2"}], "/", "2"}], " ", "+", " ", 
       RowBox[{"g", " ", "z"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", "p", ",", " ", "z"}], "}"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"bfjI", " ", "=", " ", 
  RowBox[{"BorderedFJMatrix", "[", "inconsistentSystem", "]"}]}]}], "Input",
 CellChangeTimes->{{3.996916650776016*^9, 3.996916650776016*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"e1c12f69-1038-5644-8e07-a5d221364cbd"],

