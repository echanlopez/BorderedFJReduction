Cell[TextData[{
 "A system is specified declaratively, by the three keys ",
 Cell[BoxData["\"\<kinetic-energy\>\""], "Input",ExpressionUUID->
  "dcf265b3-4728-9f4c-96fe-2c942612660d"],
 ", ",
 Cell[BoxData["\"\<symplectic-potential\>\""], "Input",ExpressionUUID->
  "14147406-ad5c-6a4d-a469-3d26a4ca99da"],
 " and ",
 Cell[BoxData["\"\<vars\>\""], "Input",ExpressionUUID->
  "71f85030-bc56-c44d-9160-20250a681943"],
 ". The kinetic term must be linear in the atomic velocities ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Derivative", "[", "1", "]"}], "[", "q", "]"}]], "Input",
  ExpressionUUID->"b1ee1265-0675-f54e-a17a-7dde879a0f35"],
 "; the variables are atomic symbols, never functions of time, which is what \
allows the reduction to preserve parametric dependence exactly."
}], "Text",
 CellChangeTimes->{{3.9969143023683224`*^9, 
  3.9969143552494392`*^9}},ExpressionUUID->"9f8f7a48-4b4f-ee40-bf83-\
8f0bed43cbcc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "BorderedFJMatrix", "]"}]], "Input",
 CellChangeTimes->{{3.9969175005632553`*^9, 3.9969175005632553`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"d7f5af43-3cb9-b043-94d3-45eab95a6214"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"MaxIterations\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"TraceStages\"\>", "\[Rule]", "False"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9969174955279465`*^9, 3.996917502967146*^9}},
 CellLabel->"Out[6]=",ExpressionUUID->"ac172443-e1f1-6845-9ba5-8794c3935500"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<MaxIterations\>\""], "Input",ExpressionUUID->
  "b621ba1a-da5d-e949-892a-6dd520e57a2e"],
 " bounds the number of ",
 StyleBox["bordering rounds",
  FontWeight->"Bold"],
 ", that is the superscript m of the extended matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["f", "TI"], 
        RowBox[{"(", 
          StyleBox["m", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "$f^(m)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26fde29b-f6fe-9546-917d-e1708a388948"],
 "; it does not bound the number of passes, and the terminal readout pass is \
always granted. ",
 Cell[BoxData["\"\<TraceStages\>\""], "Input",ExpressionUUID->
  "fa253b51-09c9-d64c-a30b-fa164bc517c4"],
 " records a per-pass trace under the key ",
 Cell[BoxData["\"\<StageData\>\""], "Input",ExpressionUUID->
  "e0f4055d-6820-024b-9bc9-74a6eb1dd70c"],
 " (Section 6)."
}], "Text",
 CellChangeTimes->{{3.9969143652582455`*^9, 3.996914421464113*^9}, {
  3.996915594218849*^9, 
  3.996915631032049*^9}},ExpressionUUID->"d6a70466-1923-f140-8d82-\
2aa5fe8cc4fa"]
}, Open  ]],

