Cell[CellGroupData[{

Cell["6.2 Branch 2: dependent constraints", "Subsection",
 CellChangeTimes->{{3.9969142210363064`*^9, 3.996914224193535*^9}},
 CellTags->
  "subsection62",ExpressionUUID->"41c780b8-8179-3843-b039-f76934a36703"],

Cell[TextData[{
 "Here the candidates are not identically zero, but each of them lies in the ",
 StyleBox["ideal",
  FontWeight->"Bold"],
 " generated by the constraints already accumulated, so it vanishes on the \
constraint surface and restricts the phase space no further. Redundancy is \
decided by a Gr\[ODoubleDot]bner normal form, which is the weak-vanishing \
notion of Dirac consistency and is exact for nonlinear constraints; the \
gradient-rank test used up to v0.1.2 fails on data of this kind."
}], "Text",
 CellChangeTimes->{{3.996916304644047*^9, 
  3.9969163053966694`*^9}},ExpressionUUID->"6c4a5c1d-5222-a64b-b9f9-\
5fae8c6cddc3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaugeSystem", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p3", " ", "-", " ", "p4"}], ")"}], "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "q2", "]"}]}], " ", "+", 
       "\n", "     ", 
       RowBox[{"p3", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "q3", "]"}]}], " ", "+", 
       " ", 
       RowBox[{"p4", "*", 
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "q4", "]"}]}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", "\n", "     ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"p3", "^", "2"}], " ", "+", " ", 
         RowBox[{"p4", "^", "2"}], " ", "-", " ", 
         RowBox[{"2", " ", "p3", "*", "q1"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q1", " ", "+", " ", 
            RowBox[{"2", " ", "q2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"q1", " ", "+", " ", 
            RowBox[{"2", " ", "q4"}]}], ")"}]}]}], ")"}]}]}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "q1", ",", " ", "q2", ",", " ", "q3", ",", " ", "q4", ",", " ", "p3", ",",
         " ", "p4"}], "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996916324833027*^9, 3.996916324833027*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"d7f6b367-a37e-9047-bb98-2af5735667df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bfj7", " ", "=", " ", 
  RowBox[{"BorderedFJMatrix", "[", "GaugeSystem", "]"}]}]], "Input",
