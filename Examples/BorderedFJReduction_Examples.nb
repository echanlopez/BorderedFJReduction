Cell[CellGroupData[{

Cell["6.3 Why the verdict is a candidate and not a detection", "Subsection",
 CellChangeTimes->{{3.996914230925167*^9, 3.9969142330839863`*^9}},
 CellTags->
  "subsection63",ExpressionUUID->"332970f7-600c-3d4a-ade9-c69ec0866849"],

Cell[TextData[{
 "The following four-variable system is taken from E. Chan-L\[OAcute]pez, ",
 StyleBox["\"From Null Modes to Gauge Generators: A Bordered \
Faddeev\[Dash]Jackiw Theory of Constraint Chains\"",
  FontSlant->"Italic"],
 " (preprint), where it is established as a structural result rather than an \
illustration."
}], "Text",ExpressionUUID->"89b13041-a636-bd48-b0fe-7569172cc0ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"counterexample", " ", "=", "\n", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<kinetic-energy\>\"", " ", "->", " ", 
      RowBox[{"q2", " ", 
       RowBox[{
        RowBox[{"Derivative", "[", "1", "]"}], "[", "q1", "]"}]}]}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<symplectic-potential\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"q1", " ", "q3"}], " ", "+", " ", 
       RowBox[{"q2", " ", "q4"}]}]}], ",", "\n", "   ", 
     RowBox[{"\"\<vars\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"q1", ",", " ", "q2", ",", " ", "q3", ",", " ", "q4"}], 
       "}"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996916377009676*^9, 3.996916377009676*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"06611e03-d452-5643-92a3-0578d2eedba6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bfjC", " ", "=", " ", 
  RowBox[{"BorderedFJMatrix", "[", "counterexample", "]"}]}]], "Input",
