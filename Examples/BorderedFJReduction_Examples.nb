Cell[TextData[{
 "The constraints are trigonometric. This is where the ideal-membership \
machinery of v0.1.3 matters: redundancy is decided after the exact embedding ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Cos", "[", "v", "]"}], "->", "c"}]], "Input",ExpressionUUID->
  "966b4d42-02f9-2347-9e75-b0e6257c7c76"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Sin", "[", "v", "]"}], "->", "s"}]], "Input",ExpressionUUID->
  "755d0406-f99d-4945-82e2-14923306bc08"],
 " with the Pythagorean relations adjoined, whereas the linear-coefficient \
test used up to v0.1.2 degenerated to zero rows on data of this kind."
}], "Text",
 CellChangeTimes->{{3.996915474117588*^9, 
  3.996915495957634*^9}},ExpressionUUID->"e7dd9465-336f-e040-b8cb-\
42163cfad314"],

