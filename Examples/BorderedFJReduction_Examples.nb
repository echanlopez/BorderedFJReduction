Cell[CellGroupData[{

Cell["4.2 Pendulum and two springs", "Subsection",
 CellChangeTimes->{{3.996914147295353*^9, 3.9969141732124825`*^9}},
 CellTags->
  "subsection42",ExpressionUUID->"b497e6b7-0276-634e-9d62-61dd97ce97ca"],

Cell[TextData[{
 "A planar pendulum whose bob is attached to two springs. The angular \
momentum is not independent of the linear momenta, so the one-form couples ",
 Cell[BoxData[
 "\[Theta]"], "Input",ExpressionUUID->"23567354-0bce-e141-a4ee-fb24098c546d"],
 " to ",
 Cell[BoxData[
 "px"], "Input",ExpressionUUID->"bd22c74f-d25f-c84b-85f7-4fbd2fcd46ff"],
 " and ",
 Cell[BoxData[
 "py"], "Input",ExpressionUUID->"bcb1c12e-ae02-cd49-9414-ffb8482f8b94"],
 " and the form degenerates."
}], "Text",
 CellChangeTimes->{{3.9969152255626354`*^9, 
  3.9969152547779503`*^9}},ExpressionUUID->"888cb567-55d9-3149-8801-\
c764bc83c624"],

